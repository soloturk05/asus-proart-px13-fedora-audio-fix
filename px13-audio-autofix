#!/usr/bin/env bash
set -euo pipefail

PATCH_DIR="/home/solo/tas2783-patches"
MOK_PRIV="/root/module-signing/MOK.priv"
MOK_DER="/root/module-signing/MOK.der"
ROOT_WORK="/var/tmp/px13-audio-autofix"
LOG="/var/log/px13-audio-autofix.log"

mkdir -p "$ROOT_WORK"
exec > >(tee -a "$LOG") 2>&1

echo
echo "==== PX13 AUDIO AUTOFIX: $(date) ===="

if pgrep -x dnf >/dev/null 2>&1 || pgrep -x dnf5 >/dev/null 2>&1 || pgrep -x rpm >/dev/null 2>&1; then
  echo "DNF/RPM şu an çalışıyor. Şimdi dokunmuyorum. Timer sonra tekrar deneyecek."
  exit 0
fi

for cmd in dnf rpm tar patch make depmod modinfo find grep install; do
  command -v "$cmd" >/dev/null 2>&1 || {
    echo "HATA: $cmd yok."
    exit 1
  }
done

if [[ ! -d "$PATCH_DIR" ]]; then
  echo "HATA: Patch klasörü yok: $PATCH_DIR"
  exit 1
fi

PATCH_COUNT="$(find "$PATCH_DIR" -maxdepth 1 -name '*.patch' | wc -l)"
if [[ "$PATCH_COUNT" -ne 16 ]]; then
  echo "HATA: 16 patch bekleniyordu, bulunan: $PATCH_COUNT"
  exit 1
fi

if [[ ! -f "$MOK_PRIV" || ! -f "$MOK_DER" ]]; then
  echo "HATA: MOK imza dosyaları yok."
  echo "$MOK_PRIV"
  echo "$MOK_DER"
  exit 1
fi

CURRENT_KV="$(uname -r)"
NEWEST_KV="$(find /usr/src/kernels -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort -V | tail -n 1 || true)"

mapfile -t KERNELS < <(printf "%s\n%s\n" "$CURRENT_KV" "$NEWEST_KV" | awk 'NF && !seen[$0]++')

if [[ "${#KERNELS[@]}" -eq 0 ]]; then
  echo "Kernel-devel klasörü bulunamadı: /usr/src/kernels"
  exit 0
fi

for KV in "${KERNELS[@]}"; do
  [[ -d "/lib/modules/$KV" ]] || continue

  echo
  echo "---- KERNEL: $KV ----"

  CURRENT_PATHS="$(modinfo -k "$KV" -n snd_soc_tas2783_sdw soundwire_amd snd_soc_sdw_utils snd_soc_core 2>/dev/null || true)"
  FIX_COUNT="$(grep -c '/updates/px13-audio/' <<< "$CURRENT_PATHS" || true)"

  if [[ "$FIX_COUNT" -eq 4 ]]; then
    echo "Zaten fixli:"
    echo "$CURRENT_PATHS"
    continue
  fi

  echo "Fix yok. Derleme başlıyor."
  echo "$CURRENT_PATHS"

  KBASE="${KV%%-*}"
  WORK="$ROOT_WORK/$KV"
  TOP="$WORK/rpmbuild"
  SRCDIR="$WORK/source-rpm"
  TESTDIR="$WORK/linux-$KBASE-test"

  rm -rf "$WORK"
  mkdir -p "$TOP" "$SRCDIR"

  TARBALL=""

  for cand in "/home/solo/rpmbuild/SOURCES/linux-$KBASE.tar.xz" "/root/rpmbuild/SOURCES/linux-$KBASE.tar.xz"; do
    if [[ -f "$cand" ]]; then
      TARBALL="$cand"
      echo "Mevcut kernel kaynağı kullanılacak: $TARBALL"
      break
    fi
  done

  if [[ -z "$TARBALL" ]]; then
    CACHED_TAR="$(find "$ROOT_WORK" -path "*/SOURCES/linux-$KBASE.tar.xz" -print -quit 2>/dev/null || true)"
    if [[ -n "$CACHED_TAR" && -f "$CACHED_TAR" ]]; then
      TARBALL="$CACHED_TAR"
      echo "Cache kernel kaynağı kullanılacak: $TARBALL"
    fi
  fi

  if [[ -z "$TARBALL" ]]; then
    cd "$SRCDIR"
    echo "Source RPM indiriliyor: kernel-core-$KV"
    dnf clean metadata || true

    if ! dnf download --source "kernel-core-$KV"; then
      echo "UYARI: Source RPM indirilemedi. Bu kernel atlandı, timer sonra tekrar deneyecek: $KV"
      continue
    fi

    SRPM="$(ls kernel-"$KBASE"-*.src.rpm 2>/dev/null | head -n1 || true)"
    if [[ -z "$SRPM" ]]; then
      echo "UYARI: Source RPM bulunamadı. Bu kernel atlandı: $KV"
      continue
    fi

    echo "Source RPM açılıyor: $SRPM"
    rpm -ivh --replacepkgs --define "_topdir $TOP" "$SRPM"

    TARBALL="$TOP/SOURCES/linux-$KBASE.tar.xz"
    if [[ ! -f "$TARBALL" ]]; then
      echo "UYARI: Kernel kaynak arşivi yok. Bu kernel atlandı: $TARBALL"
      continue
    fi
  fi

  echo "Kernel kaynağı açılıyor: linux-$KBASE"
  tar -xf "$TARBALL" -C "$WORK"

  rm -rf "$TESTDIR"
  cp -a "$WORK/linux-$KBASE" "$TESTDIR"

  cd "$TESTDIR"
  echo "16 patch uygulanıyor..."
  for p in "$PATCH_DIR"/*.patch; do
    echo "---- $(basename "$p")"
    patch -p1 --batch < "$p"
  done

  echo "Patched header kernel-devel içine kopyalanıyor..."
  cp -a "/usr/src/kernels/$KV/include/sound/soc_sdw_utils.h" "/usr/src/kernels/$KV/include/sound/soc_sdw_utils.h.orig-px13-$KBASE" 2>/dev/null || true
  cp -a "$TESTDIR/include/sound/soc_sdw_utils.h" "/usr/src/kernels/$KV/include/sound/soc_sdw_utils.h"

  echo "Modüller derleniyor..."
  make -C "/usr/src/kernels/$KV" M="$TESTDIR/sound/soc/codecs" snd-soc-tas2783-sdw.ko
  make -C "/usr/src/kernels/$KV" M="$TESTDIR/drivers/soundwire" soundwire-amd.ko
  make -C "/usr/src/kernels/$KV" M="$TESTDIR/sound/soc/sdw_utils" snd-soc-sdw-utils.ko
  make -C "/usr/src/kernels/$KV" M="$TESTDIR/sound/soc" snd-soc-core.ko

  SIGN="/usr/src/kernels/$KV/scripts/sign-file"
  if [[ ! -x "$SIGN" ]]; then
    echo "HATA: sign-file yok: $SIGN"
    exit 1
  fi

  echo "Modüller MOK ile imzalanıyor..."
  "$SIGN" sha256 "$MOK_PRIV" "$MOK_DER" "$TESTDIR/drivers/soundwire/soundwire-amd.ko"
  "$SIGN" sha256 "$MOK_PRIV" "$MOK_DER" "$TESTDIR/sound/soc/codecs/snd-soc-tas2783-sdw.ko"
  "$SIGN" sha256 "$MOK_PRIV" "$MOK_DER" "$TESTDIR/sound/soc/sdw_utils/snd-soc-sdw-utils.ko"
  "$SIGN" sha256 "$MOK_PRIV" "$MOK_DER" "$TESTDIR/sound/soc/snd-soc-core.ko"

  DST="/lib/modules/$KV/updates/px13-audio"
  mkdir -p "$DST"

  echo "Modüller kuruluyor: $DST"
  install -m 644 "$TESTDIR/drivers/soundwire/soundwire-amd.ko" "$DST/"
  install -m 644 "$TESTDIR/sound/soc/codecs/snd-soc-tas2783-sdw.ko" "$DST/"
  install -m 644 "$TESTDIR/sound/soc/sdw_utils/snd-soc-sdw-utils.ko" "$DST/"
  install -m 644 "$TESTDIR/sound/soc/snd-soc-core.ko" "$DST/"

  depmod -a "$KV"

  echo "Kontrol:"
  modinfo -k "$KV" -n snd_soc_tas2783_sdw soundwire_amd snd_soc_sdw_utils snd_soc_core

  echo "OK: $KV için PX13 audio fix kuruldu."
done

echo
echo "BİTTİ. Aktif kernel fixlendiyse reboot sonrası ses gelir."
